# Optional legacy support for previously generated short snapshot links.
BLOB_READ_WRITE_TOKEN=

# Generate once and keep stable. Rotating it invalidates existing snapshot links.
SNAPSHOT_SECRET=
# Optional locally. Vercel previews use their own deployment URL automatically;
# production defaults to https://caniworknow.com.
PUBLIC_ORIGIN=http://localhost:3000
# Optional when a local/public preview URL cannot call back into itself.
STATUS_ORIGIN=
